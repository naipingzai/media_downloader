QMainWindow { background: #0f172a; }
#Sidebar { background: #1e293b; border-right: 1px solid #334155; }
#BrandTitle { color: #facc15; font-size: 18px; font-weight: bold; }
#HeroPanel { border-radius: 8px; }
#HeroTitle { color: white; font-size: 20px; font-weight: bold; }
#Panel {
    background: #1e293b;
    border: 2px solid #64748b;
    border-radius: 6px;
}
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
SectionTitle { color: #22d3ee; font-weight: bold; font-size: 14px; }
Caption { color: #94a3b8; font-size: 12px; }
QPushButton { background: #334155; color: #e2e8f0; border: none; border-radius: 6px; padding: 8px 16px; min-height: 20px; }
QPushButton:hover { background: #475569; }
#PrimaryButton { background: #3b82f6; color: white; }
#PrimaryButton:hover { background: #2563eb; }
#DangerButton { background: #ef4444; color: white; }
#DangerButton:hover { background: #dc2626; }
QLineEdit, QComboBox {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #475569;
    border-radius: 6px;
    padding: 8px 10px;
    min-height: 20px;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #94a3b8;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #475569;
    selection-background-color: #334155;
    padding: 4px 0;
}
QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    min-height: 24px;
}
QStatusBar { background: #1e293b; color: #94a3b8; }
QDialog { background: #0f172a; color: #e2e8f0; }
QTableWidget {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 4px;
    gridline-color: #334155;
}
QTableWidget::item {
    padding: 4px;
}
QTableWidget::item:selected {
    background: #334155;
    color: #e2e8f0;
}
QHeaderView::section {
    background: #1e293b;
    color: #94a3b8;
    border: none;
    border-bottom: 1px solid #334155;
    padding: 6px 4px;
    font-weight: bold;
}
QCheckBox { color: #e2e8f0; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 2px solid #64748b;
    border-radius: 3px;
    background: transparent;
}
QCheckBox::indicator:checked {
    border-color: #3b82f6;
    background: transparent;
    image: url(none);
}
QCheckBox::indicator:unchecked {
    border-color: #64748b;
    background: transparent;
}
