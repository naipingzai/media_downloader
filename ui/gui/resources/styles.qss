QMainWindow { background: #0f172a; }
#Sidebar { background: #1e293b; border-right: 1px solid #334155; }
#BrandTitle { color: #facc15; font-size: 18px; font-weight: bold; }
#HeroPanel { border-radius: 8px; }
#HeroTitle { color: white; font-size: 20px; font-weight: bold; }
#Panel {
    background: #1e293b;
    border: 2px solid #64748b;
    border-radius: 8px;
    padding: 12px;
}
SectionTitle { color: #22d3ee; font-weight: bold; font-size: 14px; }
QPushButton { background: #334155; color: #e2e8f0; border: none; border-radius: 6px; padding: 8px 16px; }
QPushButton:hover { background: #475569; }
#PrimaryButton { background: #3b82f6; color: white; }
QLineEdit, QComboBox { background: #1e293b; color: #e2e8f0; border: 1px solid #475569; border-radius: 6px; padding: 6px 10px; }
QStatusBar { background: #1e293b; color: #94a3b8; }
