/* ============================================================
   MediaDownloader — 亮色主题
   ============================================================ */
QMainWindow { background: #f8fafc; }
QWidget { color: #0f172a; }
QDialog { background: #f8fafc; color: #0f172a; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QStatusBar { background: #f1f5f9; color: #475569; }
QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: #e2e8f0; }
QSplitter::handle:pressed { background: #dbeafe; }
#BodySplitter::handle { margin: 0 1px; }
#RightSplitter::handle { margin: 1px 0; }

/* ---------- 顶部横排栏 (TopBar) ---------- */
#TopBar {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}
#BrandTitle {
    color: #d97706; font-size: {{FS_TITLE}}; font-weight: bold;
    background: transparent; border: none;
}
#TopSep { color: #cbd5e1; font-size: {{FS_XL}}; background: transparent; border: none; }
#TopGroupLabel {
    color: #64748b; font-size: {{FS_XS}}; font-weight: bold;
    background: transparent; border: none; padding: 0 4px;
}
#TopPlatformBtn {
    background: #ffffff; color: #334155;
    border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 6px 14px; font-size: {{FS_MD}}; min-width: 60px;
}
#TopPlatformBtn:hover { background: #f1f5f9; border-color: #94a3b8; color: #0f172a; }
#TopPlatformBtn[active="true"] {
    background: #dbeafe; border-color: #2563eb; color: #2563eb; font-weight: bold;
}
#TopPlatformBtn:pressed { background: #bfdbfe; }
#TopToolBtn {
    background: #ffffff; color: #334155;
    border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 6px 14px; font-size: {{FS_MD}};
}
#TopToolBtn:hover { background: #f1f5f9; border-color: #94a3b8; color: #0f172a; }
#TopToolBtn:pressed { background: #bfdbfe; color: #0f172a; }

/* (旧版侧栏样式) */
#Sidebar { background: #ffffff; border-right: 1px solid #e2e8f0; }
#BrandSubtitle { color: #64748b; font-size: {{FS_XS}}; background: transparent; padding-left: 2px; }
#VersionLabel { color: #64748b; font-size: {{FS_XS}}; padding-left: 4px; }
#GroupTitle { color: #64748b; font-size: {{FS_XS}}; font-weight: bold; background: transparent; padding: 2px 4px; }

#SideGroup { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; }
#SidebarButton {
    background: #ffffff; color: #334155;
    border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 8px 10px; font-size: {{FS_MD}}; text-align: left;
}
#SidebarButton:hover { background: #f1f5f9; border-color: #94a3b8; color: #0f172a; }
#SidebarButton[active="true"] {
    background: #dbeafe; border-color: #2563eb; color: #2563eb; font-weight: bold;
}
#SidebarButton:pressed { background: #bfdbfe; }

/* ---------- 面板 ---------- */
#SectionPanel { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; }
#SectionTitle { color: #334155; font-size: {{FS_MD}}; font-weight: bold; background: transparent; border: none; padding: 0; }

/* ---------- 左侧外框 (作者资料 + 作品资料) ---------- */
#LeftPanel { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; }
#AuthorCard { background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; }
#WorkInfoCard { background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; }
#LeftSubTitle { color: #334155; font-size: {{FS_MD}}; font-weight: bold; background: transparent; border: none; }

/* ---------- 链接 ---------- */
#LinkInput { background: #f8fafc; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 10px; }
#LinkInput:focus { border-color: #2563eb; }

/* ---------- 按钮 ---------- */
QPushButton { background: #e2e8f0; color: #0f172a; border: none; border-radius: 6px; padding: 7px 14px; font-size: {{FS_MD}}; }
QPushButton:hover { background: #cbd5e1; }
QPushButton:disabled { background: #f1f5f9; color: #94a3b8; }
#PrimaryButton { background: #2563eb; color: white; font-weight: bold; }
#PrimaryButton:hover { background: #1d4ed8; }
#PrimaryButton:disabled { background: #cbd5e1; color: #64748b; }

/* ---------- 输入 ---------- */
QLineEdit, QComboBox, QSpinBox {
    background: #ffffff; color: #0f172a;
    border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 10px;
}
QLineEdit:focus, QComboBox:focus { border-color: #2563eb; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #64748b;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: #ffffff; color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #dbeafe;
    padding: 4px 0;
}
QComboBox QAbstractItemView::item { padding: 6px 10px; min-height: 24px; }

/* ---------- 状态栏 ---------- */
#StatusLabel, #StatusPlatform, #StatusCookie, #StatusHint, #StatusFFmpeg {
    background: transparent; border: none; padding-left: 8px; padding-right: 4px;
    font-size: {{FS_MD}}; color: #475569;
}
#StatusCookie { font-weight: bold; }
#StatusVersion { background: rgba(217, 119, 6, 0.12); color: #d97706; padding: 0 12px; font-weight: bold; border: none; font-size: {{FS_MD}}; }

/* ---------- 页签 (数据窗口等通用) ---------- */
QTabBar::tab {
    background: #f1f5f9; color: #475569;
    padding: 8px 18px 8px 14px;
    border: 1px solid #cbd5e1;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 8px;
}
QTabBar::tab:selected { background: #ffffff; color: #2563eb; font-weight: bold; }
QTabBar::tab:hover:!selected { background: #e2e8f0; color: #0f172a; }
QTabBar::close-button {
    image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'><line x1='2' y1='2' x2='8' y2='8' stroke='%2364748b' stroke-width='1.4'/><line x1='8' y1='2' x2='2' y2='8' stroke='%2364748b' stroke-width='1.4'/></svg>");
    subcontrol-position: right;
    background: transparent;
    border: none;
    width: 14px; height: 14px;
    margin: 0 6px 0 6px;
}
QTabBar::close-button:hover {
    image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 10 10'><line x1='2' y1='2' x2='8' y2='8' stroke='%23ef4444' stroke-width='1.8'/><line x1='8' y1='2' x2='2' y2='8' stroke='%23ef4444' stroke-width='1.8'/></svg>");
}

/* ---------- 内嵌页 ---------- */
#PageTitle { color: #0f172a; font-size: {{FS_TITLE}}; font-weight: bold; background: transparent; border: none; }
#PageStatus { color: #64748b; font-size: {{FS_MD}}; background: transparent; border: none; }
#PageCard { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; }
#CardTitle { color: #334155; font-size: {{FS_LG}}; font-weight: bold; background: transparent; border: none; }
#CardHint { color: #64748b; font-size: {{FS_XS}}; background: transparent; border: none; }
#CardStatus { color: #64748b; font-size: {{FS_XS}}; background: transparent; border: none; }
#CardInput { background: #f8fafc; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 10px; }
#CardInput:focus { border-color: #2563eb; }
#CookieInput {
    background: #ffffff; color: #0f172a;
    border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 8px 10px;
    font-family: monospace; font-size: {{FS_SM}};
}
#CookieInput:focus { border-color: #2563eb; }
#FontSizeLabel { color: #2563eb; font-size: {{FS_MD}}; font-weight: bold; background: transparent; border: none; min-width: 56px; }
#PagePrimaryButton { background: #1d4ed8; color: white; border: none; border-radius: 6px; padding: 8px 18px; font-size: {{FS_MD}}; font-weight: bold; }
#PagePrimaryButton:hover { background: #2563eb; }
#PagePrimaryButton:disabled { background: #cbd5e1; color: #64748b; }
#PageGhostButton { background: transparent; color: #475569; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 16px; font-size: {{FS_MD}}; }
#PageGhostButton:hover { background: #f1f5f9; color: #0f172a; }
#PageBadge { font-size: {{FS_SM}}; font-weight: bold; }
#QRHolder { background: white; border-radius: 10px; border: none; }
#QRHolder QLabel { color: #475569; font-size: {{FS_MD}}; background: transparent; border: none; }
#QRStatus { color: #64748b; font-size: {{FS_MD}}; background: transparent; border: none; }

/* ---------- 复选框 / 滑块 ---------- */
QCheckBox { color: #0f172a; spacing: 6px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 2px solid #94a3b8; border-radius: 3px; background: transparent; }
QCheckBox::indicator:checked { border-color: #2563eb; background: #2563eb; image: url("{{CHECK_ICON}}"); }
QCheckBox::indicator:hover { border-color: #2563eb; }
QSlider::groove:horizontal { height: 6px; background: #e2e8f0; border-radius: 3px; }
QSlider::handle:horizontal { width: 16px; height: 16px; margin: -5px 0; background: #2563eb; border-radius: 8px; border: none; }
QSlider::sub-page:horizontal { background: #2563eb; border-radius: 3px; }
QSlider::tick:horizontal { color: #94a3b8; }


/* ---------- 表格 ---------- */
QTableWidget { background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; border-radius: 4px; gridline-color: #e2e8f0; }
QTableWidget::item { padding: 4px; }
QTableWidget::item:selected { background: #dbeafe; color: #0f172a; }
QHeaderView::section { background: #f1f5f9; color: #475569; border: none; border-bottom: 1px solid #cbd5e1; padding: 6px 4px; font-weight: bold; }

/* ---------- 行 / 卡片 ---------- */
#InfoRow { background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 4px; }
#UserTableRow, #TableRow { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; }
#VerticalWorkCard { background: #ffffff; border: 2px solid #cbd5e1; border-radius: 8px; }

/* ---------- 日志 ---------- */
QTextEdit { background: transparent; color: #0f172a; font-family: monospace; font-size: {{FS_MD}}; border: none; }
#CollapsibleLog { background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 6px; }

/* ---------- 列表斑马纹 (property zebra) ---------- */
#UserTableRow[zebra="odd"] { background: #eef2f7; }
#UserTableRow[zebra="even"] { background: #ffffff; }
#LogPanel { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; }

/* ---------- 空态 ---------- */
#EmptyState { color: #94a3b8; padding: 40px 20px;
             background: transparent; border: none; }

/* ============================================================
   组件细化 (v2): 组件内不再写死颜色, 统一由本文件控制
   ============================================================ */

/* 过滤输入 */
#FilterInput {
    background: #ffffff; color: #0f172a;
    border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 7px 10px;
}
#FilterInput:focus { border-color: #2563eb; }

/* 日志 */
#LogPanelTitle { color: #334155; font-size: {{FS_LG}}; font-weight: bold;
    background: transparent; border: none; }
#LogPanel QTextEdit, #LogPanel QTextEdit:focus { background: transparent;
    color: #0f172a; border: none; }
#DownloadProgress { background: #ffffff; border: 1px solid #cbd5e1;
    border-radius: 4px; color: #334155; font-size: {{FS_TINY}}; text-align: center; }
#DownloadProgress::chunk { background: #2563eb; border-radius: 3px; }

/* 作品资料 */
#VideoTitle { color: #0f172a; font-size: {{FS_XL}}; font-weight: bold;
    background: transparent; border: none; padding: 0; }
#VideoSubtitle, #VideoMeta { color: #64748b; font-size: {{FS_SM}};
    background: transparent; border: none; }
#VideoState { color: #16a34a; font-size: {{FS_SM}}; font-weight: bold;
    background: transparent; border: none; }

/* 信息行 */
#InfoRowLabel { color: #64748b; background: transparent; border: none; }
#InfoRowValue { color: #0f172a; background: transparent; border: none; }

/* 作者资料 */
#AuthorAvatar { background: #ffffff; color: #94a3b8; border-radius: 26px;
    border: 2px solid #cbd5e1; font-size: {{FS_XL}}; font-weight: bold; }
#AuthorNick { color: #0f172a; font-size: {{FS_XL}}; font-weight: bold;
    background: transparent; border: none; }
#AuthorSig { color: #475569; font-size: {{FS_MD}}; background: transparent; border: none; }
#AuthorExpandBtn { color: #64748b; font-size: {{FS_MD}}; background: #f1f5f9;
  border: 1px solid #cbd5e1; border-radius: 11px; }
#AuthorExpandBtn:hover { color: #2563eb; border-color: #2563eb; }
#DialogTitle { color: #0f172a; font-size: {{FS_XL}}; font-weight: bold; border: none; }
#DialogSub { color: #64748b; font-size: {{FS_XS}}; border: none; }
#DialogBody { color: #334155; font-size: {{FS_MD}}; border: none; }
#BrowseTabs::pane { border: 1px solid #cbd5e1; border-radius: 6px; background: #ffffff; }
#BrowseTabs::tab { color: #64748b; background: transparent; padding: 6px 14px;
  border: none; border-bottom: 2px solid transparent; }
#BrowseTabs::tab:selected { color: #2563eb; border-bottom: 2px solid #2563eb; }
#BrowseTabs::tab:hover { color: #0f172a; }
#TaskPanel { background: #f8fafc; border: none; }
#TaskPanelTitle { color: #334155; font-size: {{FS_MD}}; font-weight: bold;
    background: transparent; border: none; }
#TaskTable { background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1;
    border-radius: 4px; gridline-color: #e2e8f0; font-size: {{FS_XS}}; }
#TaskTable::item { padding: 2px; }
#TaskTable QHeaderView::section { background: #f1f5f9; color: #475569;
    border: none; border-bottom: 1px solid #cbd5e1; padding: 4px;
    font-weight: bold; font-size: {{FS_XS}}; }
#AuthorStatBox { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px; }
#AuthorStatNum { color: #2563eb; font-size: {{FS_LG}}; font-weight: bold;
    background: transparent; border: none; }
#AuthorStatCap { color: #64748b; font-size: {{FS_XS}};
    background: transparent; border: none; }

/* 作品卡 */
#WorkCardBody { background: #ffffff; border: 2px solid #cbd5e1; border-radius: 8px; }
#WorkCardBody[selected="true"] {
    background: #eff6ff; border: 3px solid #2563eb;
}
#WorkCardTitle { color: #0f172a; font-size: {{FS_LG}}; font-weight: bold;
    background: transparent; border: none; }
/* 作品网格瓦片 (WorkGridPage 响应式布局) */
#WorkTileBody { background: #ffffff; border: 2px solid #cbd5e1; border-radius: 8px; }
#WorkTileBody[selected="true"] {
    background: #eff6ff; border: 3px solid #2563eb;
}
#WorkTileTitle { color: #0f172a; font-size: {{FS_MD}}; font-weight: bold;
    background: transparent; border: none; }
#WorkTileAuthor { color: #64748b; font-size: {{FS_SM}};
    background: transparent; border: none; }
#WorkTileMeta { color: #d97706; font-size: {{FS_SM}};
    background: transparent; border: none; }

/* 功能面板 */
#FeatureGroupTitle { color: #475569; font-size: {{FS_MD}}; font-weight: bold;
    background: transparent; border: none; padding: 0; }
#FeatureBtn { background: #2563eb; color: white; border: none;
    border-radius: 6px; padding: 8px 10px; font-size: {{FS_MD}}; font-weight: bold; }
#FeatureBtn:hover { background: #1d4ed8; }
#FeatureBtn:pressed { background: #1e40af; }
#FeatureBtn:disabled { background: #e2e8f0; color: #94a3b8; }
#FeatureGhostBtn { background: transparent; color: #334155;
    border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 10px;
    font-size: {{FS_MD}}; font-weight: bold; }
#FeatureGhostBtn:hover { background: #f1f5f9; border-color: #94a3b8; color: #0f172a; }
#FeatureGhostBtn:disabled { color: #94a3b8; border-color: #e2e8f0; }
#FeatureStopBtn { background: #dc2626; color: white; border: none;
    border-radius: 6px; padding: 8px 10px; font-size: {{FS_MD}}; font-weight: bold; }
#FeatureStopBtn:hover { background: #ef4444; }

/* 封面 */
#CoverLabel { background: #f1f5f9; color: #94a3b8;
    border: 1px solid #cbd5e1; border-radius: 6px; }
#CoverLabel[loaded="true"] { border: 1px solid transparent; }

/* 滚动条 */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px 0; }
QScrollBar::handle:vertical { background: #cbd5e1; border-radius: 5px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0 2px; }
QScrollBar::handle:horizontal { background: #cbd5e1; border-radius: 5px; min-width: 28px; }
QScrollBar::handle:horizontal:hover { background: #94a3b8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* 提示 */
QToolTip { background: #ffffff; color: #0f172a;
    border: 1px solid #cbd5e1; padding: 4px 8px; }

/* 用户列表 */
#UserAvatar { background: #ffffff; color: #94a3b8;
    border: 1px solid #cbd5e1; border-radius: 20px;
    font-size: {{FS_XL}}; font-weight: bold; }
#UserNick { color: #0f172a; font-size: {{FS_XL}}; font-weight: bold;
    background: transparent; border: none; }
#UserID, #UserSig { color: #64748b; font-size: {{FS_XS}};
    background: transparent; border: none; }
#UserFans { color: #2563eb; font-size: {{FS_XS}};
    background: transparent; border: none; }

/* 数据表格 */
#TableHeader { background: #f1f5f9; border: 1px solid #cbd5e1;
    border-radius: 6px; }
#TableHeaderText { color: #2563eb; font-size: {{FS_MD}};
    font-weight: bold; background: transparent; border: none; }
#TableRow[zebra="odd"] { background: #eef2f7; }
#TableRow[zebra="even"] { background: #ffffff; }
#TableCell { color: #334155; font-size: {{FS_MD}};
    background: transparent; border: none; }

/* 功能滚动区 */
#FeatureScroll { background: transparent; border: none; }

/* 登录页状态 */
#CardStatus[state="ok"] { color: #16a34a; }
#CardStatus[state="error"] { color: #dc2626; }
#CardStatus[state="muted"] { color: #64748b; }
#PageBadge[state="ok"] {
    background: rgba(22, 163, 74, 0.14); color: #16a34a;
    border-radius: 10px; padding: 3px 12px;
}
#PageBadge[state="error"] {
    background: rgba(220, 38, 38, 0.14); color: #dc2626;
    border-radius: 10px; padding: 3px 12px;
}
